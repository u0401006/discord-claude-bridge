# ── Google Chat bridge .env example ─────────────────────────────────────────
# Copy to .env.gchat and run: python3 gchat_bridge.py --env .env.gchat
# Setup guide (GCP project / Pub/Sub / Chat API): docs/gchat-setup.md

# Google Cloud 專案與 Pub/Sub pull subscription
GCHAT_PROJECT_ID=your-gcp-project-id
GCHAT_SUBSCRIPTION_ID=your-pull-subscription-id
# service account 金鑰 JSON 路徑（需有該 subscription 的 Subscriber 角色）
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# 只允許特定 space（逗號分隔，格式 spaces/AAAA...）。留空 = 全部（危險）
GCHAT_ALLOWED_SPACES=
# 只允許特定使用者（逗號分隔，格式 users/1234...）。留空 = 全部（危險）
GCHAT_ALLOWED_USERS=

# Session 範圍：auto（預設，threaded space 用 thread、DM/flat space 用 space）
# / thread / space
GCHAT_SESSION_SCOPE=auto

# 新 session 第一輪注入提示，讓後端（若有設定 Google Chat MCP server）自行
# 用 list_messages / search_messages 撈回該 space/thread 的前文。1=開（預設）/ 0=關
# Claude Code 端的 MCP 設定方式見 docs/gchat-setup.md
GCHAT_MCP_CONTEXT_HINT=1

# ── AI 後端（與 bot.py 完全相同的設定方式，三種後端皆可）──────────────────────
# Claude Code:    CLAUDE_BIN=claude
# Codex CLI:      CLAUDE_BIN=/path/to/codex-adapter.py
# OpenAI API:     CLAUDE_BIN=/path/to/openai-adapter.py
CLAUDE_BIN=claude
# 無人值守模式需明確設定（設了且 GCHAT_ALLOWED_USERS 為空會拒絕啟動）：
# CLAUDE_EXTRA_ARGS=--dangerously-skip-permissions
CLAUDE_EXTRA_ARGS=
WORKING_DIR=~/agent-dev
CLAUDE_TIMEOUT=120

# ── 速率 / session ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MIN=5
MAX_TURNS_PER_SESSION=20
# 單則訊息分段長度（字元；Chat 上限 32,000 bytes，CJK 每字 3 bytes 故預設 8000）
GCHAT_CHUNK=8000
# 同一 space 兩次發送的最小間隔（秒；Chat API 配額為 1 write/s/space）
GCHAT_SEND_INTERVAL=1.1

# log 檔路徑（gchat-sessions.json 會存在同目錄）
LOG_FILE=~/gchat-claude-bridge.log
