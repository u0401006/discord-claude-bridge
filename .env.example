# Discord bot token (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# 只允許特定 channel（逗號分隔 channel ID）。留空則全部 channel 都回應（危險）
ALLOWED_CHANNEL_IDS=123456789012345678,987654321098765432

# 只允許特定 Discord 用戶（逗號分隔 user ID）。留空則 channel 內所有人都能用（危險）
ALLOWED_USER_IDS=your_discord_user_id

# 封鎖特定 channel（優先於 ALLOWED_CHANNEL_IDS）
BLOCKED_CHANNEL_IDS=

# 封鎖特定 Discord 用戶（優先於 ALLOWED_USER_IDS）
BLOCKED_USER_IDS=

# Session 範圍：thread（預設，同一 thread 所有人共用一個對話；頻道頂層仍為每人獨立）
# channel（整個頻道共用）/ user（舊行為，每頻道每人獨立）
SESSION_SCOPE=thread

# 額外傳給 AI 後端的參數。Claude Code 無人值守模式需明確設定：
# CLAUDE_EXTRA_ARGS=--dangerously-skip-permissions
# （設了此 flag 且 ALLOWED_USER_IDS 為空時，bot 會拒絕啟動）
CLAUDE_EXTRA_ARGS=

# 附件儲存目錄與大小上限（bytes，預設 8MB）
ATTACH_DIR=/tmp/discord-attachments
ATTACH_MAX_BYTES=8388608

# Claude Code 執行的工作目錄（session 內可用 [[ws:路徑]] 覆蓋）
WORKING_DIR=~/dev

# [[ws:]] 可指向的根目錄（冒號分隔，預設 = 家目錄）
WS_ALLOWED_DIRS=~

# 後端 subprocess 的環境變數隔離：預設剝除 DISCORD_TOKEN / OPENAI_API_KEY /
# GOOGLE_APPLICATION_CREDENTIALS。用 openai-adapter 時需放行它的 key：
# BACKEND_ENV_PASS=OPENAI_API_KEY
BACKEND_ENV_PASS=
# 額外要剝除的變數（逗號分隔）
BACKEND_ENV_DENY=

# claude 執行檔路徑（預設從 PATH 找）
CLAUDE_BIN=claude

# 每次呼叫的 timeout（秒）
CLAUDE_TIMEOUT=120

# 即時進度：把後端每一步工具活動即時編輯到一則進度訊息（建議 claude CLI 後端開啟）
# 1=開 / 0=關（預設）。使用 adapter 後端亦可開，只是不會有中間步驟
STREAM_PROGRESS=1
# 進度訊息兩次編輯的最小間隔（秒）
PROGRESS_EDIT_INTERVAL=2.0

# 每人每分鐘最多幾次請求
RATE_LIMIT_PER_MIN=5

# log 檔路徑
LOG_FILE=~/discord-claude-bridge.log
