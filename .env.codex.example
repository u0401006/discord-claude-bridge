# ── Codex CLI adapter .env example ──────────────────────────────────────────
# Tested against codex-cli 0.128.0+
# Copy to .env and fill in the values.
# Bot 實例名稱：coding-codex-bridge（Codex CLI backend）

# ── 一次性 auth 設定（機器啟動前手動執行一次）────────────────────────────────
# codex 0.128.0 不讀裸 OPENAI_API_KEY，需先登入：
#   printenv OPENAI_API_KEY | codex login --with-api-key
# credentials 儲存在 ~/.codex/，之後不需再設 OPENAI_API_KEY。
# 登入後驗證：codex exec --dangerously-bypass-approvals-and-sandbox "hello"

# Discord bot token
DISCORD_TOKEN=your_discord_bot_token

# 允許的 channel ID（逗號分隔）
ALLOWED_CHANNEL_IDS=1491822396146061424

# 允許的 user ID（空白 = channel 內所有人）
ALLOWED_USER_IDS=1107506879069945886

# ── Codex CLI 執行環境 ────────────────────────────────────────────────────────
# 指向 codex-adapter.py 取代 claude
CLAUDE_BIN=/Users/capo_mac_mini/agent-dev/discord-claude-bridge/codex-adapter.py
# 傳給 adapter 的額外參數（可覆蓋預設 model）
CLAUDE_EXTRA_ARGS=--model o4-mini

# Codex CLI 路徑（預設從 PATH 找）
CODEX_BIN=codex
# Codex 每次呼叫 timeout（秒）
CODEX_TIMEOUT=120
# 保留歷史輪數（每輪 = 1 user + 1 assistant），作為 native resume 失敗時的 fallback
CODEX_HISTORY_TURNS=6

# ── 工作目錄 ─────────────────────────────────────────────────────────────────
WORKING_DIR=~/agent-dev

# ── 速率 / session ────────────────────────────────────────────────────────────
CLAUDE_TIMEOUT=130
RATE_LIMIT_PER_MIN=5
MAX_TURNS_PER_SESSION=20
LOG_FILE=~/agent-dev/instances/bot-work/bot-codex.log
